{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/league",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/monday",
      "schedule": "0 15 * * 1"
    }
  ]
}
