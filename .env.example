# Copy to .env for local dev. On Vercel, set these in Project → Settings → Environment Variables.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# 32+ random characters; encrypts the login cookie. e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=
# Optional: force the OAuth redirect base (must match the Redirect URI in your Yahoo app + /api/auth/callback)
PUBLIC_URL=
# Optional: pick a league if your Yahoo account has more than one NBA league
LEAGUE_ID=33458
